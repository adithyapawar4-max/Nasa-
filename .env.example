# Google Sheets integration (read-only spreadsheet)
# Spreadsheet ID from the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<VITE_GOOGLE_SHEETS_ID>/edit
VITE_GOOGLE_SHEETS_ID=

# Range to read. Example: Experiments!A1:Z1000
VITE_GOOGLE_SHEETS_RANGE=

# Google Sheets API key (browser-visible, restrict it to the Sheets API + your origin)
VITE_GOOGLE_SHEETS_API_KEY=

# Demo mode: default state for the Settings > Demo simulation switch.
# The user's saved choice (localStorage) overrides this value.
# NEVER ship demo mode enabled by default in production.
# VITE_DEMO_MODE=true

# Never put service-account private keys, OAuth secrets, or service-role keys here.